# SEC EDGAR 접근 정책: User-Agent에 이름과 이메일을 반드시 포함 (https://www.sec.gov/os/accessing-edgar-data)
SEC_USER_AGENT="Your Name your.email@example.com"
# 초당 요청 수 상한 (SEC 정책 10 이하)
SEC_MAX_RPS=8
# 캐시 디렉터리 (git 제외)
PEERLENS_CACHE_DIR=data/cache

# Cohere (임베딩·리랭커) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v4.0-fast
