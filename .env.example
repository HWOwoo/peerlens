# SEC EDGAR 접근 정책: User-Agent에 이름과 이메일을 반드시 포함 (https://www.sec.gov/os/accessing-edgar-data)
SEC_USER_AGENT="Your Name your.email@example.com"
# 초당 요청 수 상한 (SEC 정책 10 이하)
SEC_MAX_RPS=8
# 캐시 디렉터리 (git 제외)
PEERLENS_CACHE_DIR=data/cache

# Cohere (임베딩·리랭커) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v4.0-fast

# OpenAI (Planner·Writer·Verifier LLM) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 글쓰기·검증용(고품질) / 계획·판정용(빠른 모델). 비워 두면 키 확인 후 자동 선택값으로 채움
OPENAI_MODEL=gpt-6-sol
OPENAI_MODEL_FAST=gpt-6-luna

# 비용 관리
# 같은 입력이면 저장된 LLM 응답 재사용 (재실행·재채점·화면 테스트 비용 0)
PEERLENS_LLM_CACHE=1
# dev = 모든 단계를 저가 모델(OPENAI_MODEL_FAST)로 — 코드 수정 확인용. 비우면 정식 구성
PEERLENS_PROFILE=
# 실행 1건 토큰 상한(입력+출력). 넘으면 재작성 생략 후 경고로 종료. 0 = 제한 없음
PEERLENS_RUN_TOKEN_BUDGET=80000

# LLM 제공사 전환: openai(정식 구성) | gemini(개발용 무료 등급)
PEERLENS_LLM_PROVIDER=openai
# Google Gemini API — https://aistudio.google.com/apikey (무료 등급: 입력이 Google 서비스 개선에 쓰일 수 있음, 공개 데이터만 사용)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FAST=
# 무료 등급 분당 요청 한도 대응: 호출 사이 최소 간격(초)
GEMINI_MIN_INTERVAL_S=6
# 과부하(503) 때 차례로 넘어갈 대체 모델 (쉼표 구분)
GEMINI_FALLBACK_MODELS=
